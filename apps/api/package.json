{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "db:migrate": "tsx src/database/run-migrate.ts",
    "db:seed": "tsx src/database/run-seed.ts"
  },
  "dependencies": {
    "@atlas/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "kysely": "^0.28.2",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.1",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "oxlint": "^1.90.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
