# PostgreSQL connection (used by apps/api)
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas_infra

# API server settings
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# JWT signing secrets (generate long random strings in production)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
OAUTH_STATE_SECRET=replace-with-a-long-random-oauth-state-secret-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookie settings (set COOKIE_SAME_SITE=none and COOKIE_SECURE=true for cross-origin HTTPS)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Google OAuth 2.0 credentials (from Google Cloud Console -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Frontend Vite API proxy target (defaults to http://localhost:4001)
VITE_API_PROXY_TARGET=http://localhost:4001
